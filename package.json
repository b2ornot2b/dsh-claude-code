{
  "name": "dsh-claude-code",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code integration for the DeepSeek Harness (dsh): capability seam, model-facing tools, and Agent adapter, developed out-of-tree against published @deepseek-ai/dsh-* packages.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.tests.json",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:composition": "pnpm run build && vitest run --project composition",
    "test:live": "pnpm run build && DSH_CC_LIVE=1 vitest run --project unit --project examples packages/claude-code/tests/live packages/tool-claude-code/tests/live packages/claude-code-agent/tests/live examples/delegation-demo",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-claude-code": "workspace:*",
    "@deepseek-ai/dsh-claude-code-agent": "workspace:*",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-jobs-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-claude-code": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b2ornot2b/dsh-claude-code.git"
  }
}
